[Unit]
Description=Keep the coolcode.ca/nasa daily refresh running
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nasa-keepalive.env
ExecStart=/usr/local/bin/nasa-keepalive.sh
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
